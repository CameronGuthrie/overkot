# Optional test key for a source run pointed at a loopback Market API.
# Production Market access uses the public read gateway and account sessions.
OVERKOT_MARKET_API_KEY=
# auto includes the website launcher unless a checkout or commit is explicitly selected.
# Official CI selects enabled and supplies the pinned private source checkout.
OVERKOT_MARKET_UI=auto
# Set this in the shell or .env.local to select the official build's public endpoints.
# OVERKOT_SERVICES_FILE=config/official-services.json
# Local development feeds may use localhost. A custom manifest alone receives no bearer token.
OVERKOT_DATA_MANIFEST_URL=
